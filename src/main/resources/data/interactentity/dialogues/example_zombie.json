{
  "target": {
    "name": "Старый Зомби",
    "tag": "old_zombie"
  },
  "display_name": "&6[&eСтарый Зомби&6]",
  "avatar": "minecraft:textures/entity/zombie/zombie.png",
  "invulnerable": true,
  "persistent": true,

  "entry": "start",

  "on_revisit": {
    "default": "&7*Старый Зомби грустно смотрит на тебя*",
    "conditions": [
      {
        "condition": { "type": "quest_status", "quest_id": "cure_zombie", "status": "active" },
        "text": "&fТы уже нашёл яблоко?",
        "start_node": "check_apple"
      },
      {
        "condition": { "type": "quest_status", "quest_id": "cure_zombie", "status": "completed" },
        "text": "&aСпасибо тебе, друг..."
      }
    ]
  },

  "nodes": {
    "start": {
      "random_text": [
        "&7*Зомби смотрит на тебя мутными глазами*",
        "&7*Зомби медленно поднимает голову*",
        "&7*Зомби тихо стонет и смотрит на тебя*"
      ],
      "next": "intro",
      "actions": [
        { "type": "play_sound", "sound": "minecraft:entity.zombie.ambient", "volume": 0.8, "pitch": 0.7 }
      ]
    },

    "intro": {
      "text": "&fМне... &cочень плохо&f... Я помню, что был человеком. Ты можешь помочь мне?",
      "options": [
        { "text": "&aКонечно, что тебе нужно?", "next": "explain" },
        { "text": "&7Выглядишь страшновато...", "next": "scary" },
        {
          "text": "&6[Ты победил много зомби] Ты как те, кого я убивал?",
          "next": "killer_branch",
          "condition": { "type": "killed_mob", "entity": "minecraft:zombie", "count": 3 }
        },
        {
          "text": "&d[Ночью] Странно видеть тебя в такой час...",
          "next": "night_branch",
          "condition": { "type": "time_of_day", "period": "night" }
        },
        { "text": "&cНет, мне всё равно.", "next": "refuse" }
      ]
    },

    "killer_branch": {
      "text": "&cДа... я видел тебя в бою. Но я &eне такой&c. Пожалуйста, поверь мне.",
      "actions": [
        { "type": "set_var", "name": "trust_zombie", "value": "1" }
      ],
      "next": "explain"
    },

    "night_branch": {
      "text": "&dНочь — единственное время, когда я чувствую себя собой...",
      "actions": [
        { "type": "spawn_particles", "particle": "minecraft:soul", "count": 15, "spread": 0.5, "target": "entity" }
      ],
      "next": "explain"
    },

    "explain": {
      "text": "&fМне нужно &6золотое яблоко&f. Оно может вернуть мне рассудок... хотя бы ненадолго.",
      "next": "offer"
    },

    "scary": {
      "text": "&7*Зомби грустно опускает голову*",
      "next": "scary2"
    },

    "scary2": {
      "text": "&fДа... я знаю. Но внутри я всё ещё &eчеловек&f. Помоги мне, прошу.",
      "options": [
        { "text": "&aХорошо, я помогу.", "next": "explain" },
        { "text": "&cИзвини, не могу.", "next": "refuse" }
      ]
    },

    "offer": {
      "text": "&fПринесёшь мне &6[Золотое яблоко]&f?",
      "options": [
        {
          "text": "&aДа, принесу!",
          "next": "quest_start",
          "actions": [
            {
              "type": "start_quest",
              "quest": {
                "id": "cure_zombie",
                "title": "&6Лечение зомби",
                "description": "&fПринеси Старому Зомби золотое яблоко.",
                "required_item": { "id": "minecraft:golden_apple", "count": 1 },
                "objectives": ["&7[ ] Принести золотое яблоко"]
              }
            }
          ]
        },
        { "text": "&7Сначала подумаю...", "next": "exit_think" },
        { "text": "&cНет, не буду.", "next": "refuse" }
      ]
    },

    "exit_think": { "text": "&7*Зомби кивает*" },

    "quest_start": {
      "text": "&fСпасибо... &7Я буду ждать.",
      "actions": [
        { "type": "play_sound", "sound": "minecraft:entity.player.levelup", "volume": 0.5, "pitch": 1.5 }
      ]
    },

    "refuse": {
      "text": "&7...",
      "next": "end_refuse"
    },

    "end_refuse": { "text": "&7*Зомби отворачивается и замирает*" },

    "check_apple": {
      "text": "&fТы нашёл &6золотое яблоко&f?",
      "options": [
        {
          "text": "&aДа, вот оно!",
          "next": "give_apple",
          "condition": { "type": "has_item", "item": "minecraft:golden_apple", "count": 1 }
        },
        { "text": "&7Ещё ищу...", "next": "end_wait" },
        {
          "text": "&cПередумал помогать.",
          "next": "give_up",
          "actions": [{ "type": "fail_quest", "quest_id": "cure_zombie" }]
        }
      ]
    },

    "end_wait": { "text": "&7*Зомби стоит неподвижно и ждёт*" },
    "give_up": { "text": "&7*Зомби тихо стонет и отворачивается*" },

    "give_apple": {
      "text": "&7*Зомби дрожащими руками берёт яблоко и съедает его*",
      "actions": [
        { "type": "remove_item", "item": "minecraft:golden_apple", "count": 1 },
        { "type": "camera_shake", "intensity": 0.6, "duration": 30 },
        { "type": "spawn_particles", "particle": "minecraft:heart", "count": 20, "spread": 0.8, "target": "entity" },
        { "type": "play_sound", "sound": "minecraft:entity.player.levelup", "volume": 1.0, "pitch": 1.0 }
      ],
      "next": "transform"
    },

    "transform": {
      "text": "&e*Туман рассеивается. Глаза зомби проясняются.*",
      "actions": [
        { "type": "spawn_particles", "particle": "minecraft:end_rod", "count": 30, "spread": 1.0, "target": "entity" },
        { "type": "give_effect", "effect": "minecraft:regeneration", "duration": 200, "amplifier": 1, "target": "player" }
      ],
      "next": "finish"
    },

    "finish": {
      "text": "&eЯ... &fчувствую себя лучше. Туман в голове отступает...",
      "options": [
        { "text": "&aРад за тебя.", "next": "reward" },
        {
          "text": "&6[Доверие] Я знал, что ты всё ещё человек.",
          "next": "trust_reward",
          "condition": { "type": "if_var", "name": "trust_zombie", "op": "eq", "value": "1" }
        }
      ]
    },

    "reward": {
      "text": "&aСпасибо. Возьми &25 изумрудов&a.",
      "actions": [
        { "type": "update_quest", "quest_id": "cure_zombie", "objectives": ["&a[✔] Принести золотое яблоко"] },
        { "type": "complete_quest", "quest_id": "cure_zombie" },
        { "type": "give_item", "item": "minecraft:emerald", "count": 5 }
      ]
    },

    "trust_reward": {
      "text": "&aТвоё доверие значит больше золота. Возьми &d10 изумрудов&a и &bзелье силы&a.",
      "actions": [
        { "type": "update_quest", "quest_id": "cure_zombie", "objectives": ["&a[✔] Принести золотое яблоко"] },
        { "type": "complete_quest", "quest_id": "cure_zombie" },
        { "type": "give_item", "item": "minecraft:emerald", "count": 10 },
        { "type": "give_effect", "effect": "minecraft:strength", "duration": 2400, "amplifier": 0 }
      ]
    }
  }
}
